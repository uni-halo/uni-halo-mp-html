.halo-plugin-wrapper {
    width: 100%;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 24rpx 0;
    padding: 24rpx;
    border-radius: 12rpx;
    background-color: #ffff;
    overflow: hidden;
    border: 2rpx solid #eee;
}

.halo-plugin-status.error {
    border-style: dashed;
    border-color: #e88080;
    color: #e88080;
    background-color: rgba(232, 128, 128, 0.075);
}

.halo-plugin-status.loading {
    border-style: dashed;
    border-color: rgba(3, 174, 252, 1);
    color: rgba(3, 174, 252, 1);
    background-color: rgba(3, 174, 252, 0.075);
}

.halo-plugin-wrapper-error {
    width: 100%;
    text-align: center;
    font-size: 24rpx;
}

.vote-card-head {
    margin-bottom: 12rpx;
}

.vote-card-head .title {
    padding: 12rpx 0;
    margin-top: 8rpx;
    margin-bottom: 4rpx;
    font-size: 30rpx;
    font-weight: bold;
}

/*徽章*/
.badge {
    box-sizing: border-box;
    position: absolute;
    right: 0;
    top: 0;
    font-size: 24rpx;
    padding: 2rpx 12rpx;
    /*background-color: #f5c618;*/
    border-radius: 0 6rpx 0 12rpx;
    background-image: linear-gradient(to right, rgb(255, 152, 0), rgb(255, 110, 0));
    color: #ffffff;
}

.vote-card-body {

}

.vote-card-body .remark {
    box-sizing: border-box;
    color: rgba(0, 0, 0, 0.75);
    margin-bottom: 24rpx;
}

.vote-card-foot {
    box-sizing: border-box;
    padding-top: 6px;
    margin-top: 12px;
    border-top: 2rpx solid #eee;
}

.is-voted-item {
    min-height: 72rpx;
    box-sizing: border-box;
    position: relative;
    border-radius: 12rpx;
    background-color: rgba(229, 229, 229, 0.75);
    font-size: 24rpx;
    overflow: hidden;
}

.is-voted-item::before {
    content: "";
    width: var(--percent);
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(208, 208, 208, 1);
    z-index: 0;
    border-radius: 6rpx;
}

.is-voted-item.selected {
    background-color: rgba(3, 169, 244, 0.35);
    color: #ffffff;
}

.is-voted-item.selected::before {
    background-color: rgba(3, 169, 244, 1);
}

.is-voted-item-content {
    box-sizing: border-box;
    min-height: 72rpx;
    padding: 12rpx 24rpx;
    position: relative;
    z-index: 2;
}

.vote-select-option {
    box-sizing: border-box;
    padding: 20rpx 24rpx;
    font-size: 24rpx;
    border-radius: 12rpx;
    transition: all 0.1s ease-in-out;
}

.tag-badge {
    padding: 6rpx 16rpx;
}

.tag {
    padding: 4rpx 16rpx;
}

.single {

}

.multiple {

}

.pk {
    box-sizing: border-box;
    width: 100%;
}

.pk-container {
    box-sizing: border-box;
    width: 100%;
    display: flex;
}

.radio-item {
    flex-grow: 1;
    min-width: 30% !important;
    max-width: 70% !important;
}

.radio-left {
}

.radio-right {
}

.option-item {
    box-sizing: border-box;
    width: 100%;
    padding: 24rpx;
    border-radius: 12rpx;
}

.option-item-left {
    /*background: linear-gradient(90deg, #3B82F6, #60A5FA);*/
    background: linear-gradient(90deg, #03aefc, #03d8fc);
    color: white;
    clip-path: polygon(0 0, calc(100% - 40rpx) 0, 100% 100%, 0 100%);
}

.option-item-right {
    /*background: linear-gradient(90deg, #F87171, #EF4444);*/
    background: linear-gradient(90deg, #ff8f8f, #ff5a4e);
    color: white;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 40rpx 100%);
    text-align: right;
}

.option-foot {
    width: 100%;
    margin-top: 6rpx;
    font-size: 24rpx;
    color: #666;
}

.option-foot .left {
    box-sizing: border-box;
    padding-right: 24rpx;
}

.option-foot .right {
    box-sizing: border-box;
    padding-left: 24rpx;
}

.btn {
    font-size: 28rpx !important;
}

